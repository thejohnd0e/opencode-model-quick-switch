{
  "name": "opencode-model-quick-switch",
  "version": "0.1.0",
  "description": "One-click switching between native Recent models from the OpenCode V2 terminal sidebar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejohnd0e/opencode-model-quick-switch.git"
  },
  "homepage": "https://github.com/thejohnd0e/opencode-model-quick-switch#readme",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun --conditions=browser test src",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/tui.ts --target=bun --format=esm --external=@opencode/plugin/tui --external=@opentui/core --external=@opentui/solid --external=solid-js --outfile=dist/tui.js",
    "prepublishOnly": "bun run build && bun run test && bun run typecheck"
  },
  "dependencies": {},
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@opencode/theme": "^2.2.6",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.5.0"
  }
}
